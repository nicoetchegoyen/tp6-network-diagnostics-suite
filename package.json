{
  "name": "network-diagnostics-suite",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/start-expo.mjs",
    "start:client": "expo start --go --lan",
    "android": "expo run:android",
    "preandroid": "node scripts/prepare-native.cjs",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "backend": "node backend/server.mjs",
    "lab": "tsx scripts/snmp-agent.ts",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "format": "prettier --write src tests backend scripts/*.ts scripts/*.mjs scripts/*.cjs *.js *.json docs/*.md README.md"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "11.4.1",
    "bonjour-service": "^1.4.4",
    "buffer": "^6.0.3",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.14",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.12",
    "expo-location": "~19.0.8",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.10",
    "@types/ssh2": "^1.15.6",
    "babel-preset-expo": "~54.0.10",
    "prettier": "^3.6.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
